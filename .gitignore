# ==========================================
# PharmaForce 360° Git Ignore Rules
# ==========================================

# Operating System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# Jupyter Notebooks Checkpoints & Temporary Exports
.ipynb_checkpoints
notebooks/output_data/
notebooks/*.zip

# Power BI Project (.pbip) - Local Cache & User Settings
# Microsoft Power BI recommendation: exclude cache and local settings
**/cache.abf
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Microsoft Office temporary lock files
~$*.docx
~$*.xlsx
~$*.pptx

# IDE & Editor Settings
.idea/
*.swp
*.swo
*~
